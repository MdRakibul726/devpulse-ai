# DevPulse AI Environment Variables Example
# Copy this file to .env.local and fill in your keys

# Optional: GitHub Personal Access Token to increase API rate limit from 60 to 5,000 requests/hour
# Generate at: https://github.com/settings/tokens (no special scopes needed for public repos)
GITHUB_TOKEN=

# AI Copilot Configuration (Choose Gemini or OpenAI)
# Google Gemini API Key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional OpenAI API Key if using OpenAI model fallback
OPENAI_API_KEY=
